# secrets — never commit
.env
.env.*
!.env.example
*.pem
id_rsa
id_ed25519

# local harness state and traces
.desmos/
runs/

# vendored clones. grok-build is committed — desmos-tui imports it, so it is
# source, not a reference copy, and a clone must build without fetching it.
# Everything else under vendor/ is an analysis clone and stays out.
vendor/*
!vendor/grok-build/
vendor/grok-build/.git-upstream/
vendor/grok-build/target/
vendor/grok-build/**/target/

# tooling caches
.mypy_cache/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
*.log

# rust
target/

# python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
dist/
build/

.DS_Store
.idea/
.vscode/

# termctrl raw recordings (large, re-derivable)
captures/*.termctrl
