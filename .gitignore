# secrets — never commit
.env
.env.*
!.env.example
*.pem
id_rsa
id_ed25519

# local harness state and traces
.desmos/
runs/

# vendored clones. grok-build is committed — desmos-tui imports it, so it is
# source, not a reference copy, and a clone must build without fetching it.
# Everything else under vendor/ is an analysis clone and stays out.
vendor/*
!vendor/grok-build/
vendor/grok-build/.git-upstream/
vendor/grok-build/target/
vendor/grok-build/**/target/
# fff is committed too: desmos-tui and the fff-python extension both build
# from this one tree (Phase 6). Its own workspace, reached via a path dep.
!vendor/fff/
# Commit only the build subset (the four workspace crates, the python
# bindings, and .cargo/config.toml — its macOS dynamic_lookup link args are
# what let the abi3 extension link). The rest of the upstream clone (.github,
# Formula, lua, docs) is noise; ignore it so a fresh clone builds from exactly
# what is tracked.
vendor/fff/*
!vendor/fff/.cargo/
!vendor/fff/Cargo.toml
!vendor/fff/Cargo.lock
!vendor/fff/LICENSE
!vendor/fff/crates/
vendor/fff/crates/*
!vendor/fff/crates/fff-core/
!vendor/fff/crates/fff-grep/
!vendor/fff/crates/fff-query-parser/
!vendor/fff/crates/fff-python/
!vendor/fff/packages/
vendor/fff/packages/*
!vendor/fff/packages/fff-python/
vendor/fff/**/target/
# memex is the <recall> engine, kept as a submodule (its tantivy+ort deps
# must stay out of the desmos build, so it is a pinned external repo, not a
# vendored crate). The gitlink is tracked; the checkout's build output is not.
!vendor/memex
vendor/memex/target/
# herdr: the agent runtime, vendored as a fork submodule (staged; no
# desmos consumer wires it yet). Same shape as memex/comet — pinned repo,
# build output ignored.
!vendor/herdr
vendor/herdr/target/
# ~/.gitignore_global carries a bare `build/`, which matches
# vendor/grok-build/crates/build/ -- the home of xai-proto-build, a workspace
# member and a path dep of our root Cargo.toml. Committing the tree and then
# dropping one crate is worse than not committing it: the repo looks
# self-contained and a fresh clone still fails to build. A repo rule beats a
# global one, so re-include the directory here.
!vendor/grok-build/crates/build/

# tooling caches
.mypy_cache/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
*.log

# rust
target/

# python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
# Root-anchored. Unanchored `build/` also matched
# vendor/grok-build/crates/build/, which holds xai-proto-build -- a workspace
# member and a path dep of our root Cargo.toml. That silently dropped one crate
# out of a tree we had just committed to make a clone self-contained, and a
# `!` rule cannot win it back: git never descends into an excluded directory.
/dist/
/build/

.DS_Store
.idea/
.vscode/

